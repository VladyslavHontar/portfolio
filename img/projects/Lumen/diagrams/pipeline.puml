@startuml pipeline
' Shred-to-wire hot path. Rendered to SVG by build_diagrams.sh.
skinparam backgroundColor transparent
skinparam shadowing false
skinparam note {
  BackgroundColor FILL
  BorderColor STROKE
  FontColor TEXT
}
skinparam defaultFontName Helvetica
skinparam defaultFontSize 13
skinparam roundCorner 8
skinparam ArrowColor STROKE
skinparam ArrowFontColor TEXT
skinparam rectangle {
  BackgroundColor FILL
  BorderColor STROKE
  FontColor TEXT
}
skinparam database {
  BackgroundColor FILL
  BorderColor STROKE
  FontColor TEXT
}
skinparam package {
  BackgroundColor TRANSPARENT
  BorderColor STROKE
  FontColor MUTED
  FontStyle plain
}

rectangle "Shred stream\nraw entries, pre-confirmation" as shreds
rectangle "Tick counter\nslot's last tick → blockhash" as tick
rectangle "Slot clock\nfirst-shred anchor, newest slot" as clock

package "Router — one thread" {
  rectangle "Decode + pre-filter\nprogram-id scan on raw bytes" as decode
  rectangle "ALT resolve\nchain slot rules, cached" as alt
  rectangle "Account-lock scheduler\nper-address FIFO, agave lock rules" as sched
}

package "Workers — pinned cores" {
  rectangle "SVM execute\nspeculative head snapshot → simulate → append" as svm
}

package "Route thread — owns the router" {
  rectangle "Route search\nreprice moved pools · solve their markets" as finder
}

package "Executor" {
  rectangle "Gate\nread-only simulate per candidate\nmost profitable wins · dedup" as gate
}

rectangle "Bank\nspeculative head · engine pool · LMDB root" as bank
rectangle "Pool registry + book\npools by token pair" as graph
rectangle "Dispatcher\na bid per sender that reaches\nthe leader · sign" as disp
rectangle "Senders\nJito · Astralane · Helius\n0slot · Nozomi · direct TPU" as senders

shreds --> decode
shreds --> tick
shreds --> clock
decode --> alt
alt --> sched
sched --> svm : locks held
svm --> sched : locks back\nright after execute
svm --> finder : moved pools
finder --> gate
svm <--> bank : snapshot head,\nappend writes
graph --> finder
clock -[STROKE,dashed]-> finder : skip routes\nfor stale slots
gate --> disp
tick -[STROKE,dashed]-> disp : blockhash\n(or durable nonce)
disp --> senders
@enduml
