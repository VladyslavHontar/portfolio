@startuml system
' One flow, two lanes, one bank. Rendered to SVG by build_diagrams.sh.
skinparam backgroundColor transparent
skinparam shadowing false
skinparam note {
  BackgroundColor FILL
  BorderColor STROKE
  FontColor TEXT
}
skinparam defaultFontName Helvetica
skinparam defaultFontSize 13
skinparam roundCorner 8
skinparam ArrowColor STROKE
skinparam ArrowFontColor TEXT
skinparam rectangle {
  BackgroundColor FILL
  BorderColor STROKE
  FontColor TEXT
}
skinparam database {
  BackgroundColor FILL
  BorderColor STROKE
  FontColor TEXT
}
skinparam package {
  BackgroundColor TRANSPARENT
  BorderColor STROKE
  FontColor MUTED
  FontStyle plain
}

skinparam cloud {
  BackgroundColor FILL
  BorderColor STROKE
  FontColor TEXT
}
skinparam nodesep 30
skinparam ranksep 40
left to right direction

cloud "Solana\nnetwork" as net

package "Hot lane — reacts inside the slot" {
  rectangle "Shred stream\nentries before\nconfirmation" as shreds
  rectangle "Router\ndecode · ALT\naccount locks" as router
  rectangle "Workers × N\nSVM execute\nroute finder" as workers
  rectangle "Executor\ngate · dedup\nsender by leader" as exec
  rectangle "Dispatcher\nsign · send" as disp
  rectangle "Senders\nJito · Astralane · Helius\nNextBlock · 0slot · TPU …" as senders
}

package "Bank — one process, no network in the loop" {
  rectangle "Speculative head\nshred guesses, per slot" as spec
  rectangle "Pending fork\nconfirmed slot in replay" as pending
  database "Root\nLMDB + read cache" as root
}

package "Confirmed lane — trails the chain by 1–2 slots" {
  rectangle "Complete blocks\nP2P lane" as blocks
  rectangle "Replay + verify\nsame SVM, bank hash\nvs network" as replay
}

net --> shreds
shreds --> router
router --> workers
workers --> exec
exec --> disp
disp --> senders
senders --> net

workers -up-> spec : read snapshot,\nappend writes
spec ..> root : misses fall through

net --> blocks
blocks --> replay
replay --> pending
pending --> root : commit_slot
pending ..> spec : evict guesses\nthe block supersedes
@enduml
